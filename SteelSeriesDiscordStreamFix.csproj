<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>

    <RootNamespace>SteelSeriesDiscordStreamFix</RootNamespace>
    <AssemblyName>SteelSeriesDiscordStreamFix</AssemblyName>
    <ApplicationIcon>steelseries.ico</ApplicationIcon>

    <!-- AnyCPU: runs as 64-bit on a 64-bit Windows. Every dependency (NAudio, Velopack) is pure managed code,
         so there is no reason to force a 32-bit process. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>

    <!-- publish.ps1 passes -p:Version=x.y.z, which also sets AssemblyVersion / FileVersion.
         The default below is only used for a plain build (Visual Studio, GitHub Actions). -->
    <Version Condition="'$(Version)' == ''">1.0.45</Version>
    <Title>SteelSeriesDiscordStreamFix</Title>
    <Product>SteelSeriesDiscordStreamFix</Product>
    <Company>SLVR</Company>
    <Copyright>Copyright © 2026 SLVR</Copyright>
    <Description>Audio utility to mute Discord mic and manage SteelSeries Sonar</Description>

    <!-- The Launcher sub-project and build output folders live inside this folder: keep them out of the globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Launcher\**;publish\**;publish-launcher\**;Releases\**;packages\**;logs\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!-- Build-time only: merges the DLLs into the single .exe (settings are in FodyWeavers.xml). -->
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
