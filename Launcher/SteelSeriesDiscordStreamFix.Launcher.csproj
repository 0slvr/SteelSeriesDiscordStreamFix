<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single file users download. It is NOT an installer wizard and NOT a silent installer:
    it opens the options window first and only installs (the embedded Velopack Setup.exe) when
    the user presses Save. publish.ps1 builds it AFTER `vpk pack` and passes:
        -p:SetupExe=<path to the Velopack Setup.exe>   (embedded as the resource "Setup.exe")
        -p:Version=<x.y.z>                             (the version this file installs)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The output keeps the name users already know, so the README / download link does not change. -->
    <AssemblyName>SteelSeriesDiscordStreamFix-win-Setup</AssemblyName>
    <RootNamespace>SteelSeriesDiscordStreamFix.Launcher</RootNamespace>
    <ApplicationIcon>..\steelseries.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>SteelSeries Discord Stream Fix</Product>
    <Description>SteelSeries Discord Stream Fix</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same look as the app's own Settings window. -->
    <Compile Include="..\ModernControls.cs" Link="ModernControls.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SetupExe)' != '' And Exists('$(SetupExe)')">
    <EmbeddedResource Include="$(SetupExe)" LogicalName="Setup.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
